{
  "openapi": "3.0.3",
  "info": {
    "title": "QuantumHealth AI Platform API",
    "description": "Hybrid Quantum-Classical ML Diagnostic Decision Support (HackYard 2026 - Team Code: 404)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://qhai-api.eba-kubitprt.us-east-1.elasticbeanstalk.com",
      "description": "Live AWS Elastic Beanstalk Production Server"
    },
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Check System & Simulator Health",
        "operationId": "checkHealth",
        "responses": {
          "200": {
            "description": "System operational status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "team_name": { "type": "string" },
                    "team_code": { "type": "string" },
                    "quantum_backend": { "type": "string" },
                    "simulation_mode": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predict": {
      "post": {
        "summary": "Calibrated Hybrid Disease Prediction",
        "operationId": "predictDisease",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["disease", "features"],
                "properties": {
                  "disease": { "type": "string", "example": "heart" },
                  "features": { "type": "object" },
                  "mode": { "type": "string", "default": "hybrid" },
                  "quantum_weight": { "type": "number", "default": 0.05 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diagnostic consensus and calibrated risk probability",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "disease": { "type": "string" },
                    "status": { "type": "string" },
                    "hybrid_result": {
                      "type": "object",
                      "properties": {
                        "risk_probability": { "type": "number" },
                        "risk_level": { "type": "string" }
                      }
                    },
                    "quantum_result": {
                      "type": "object",
                      "properties": {
                        "risk_probability": { "type": "number" },
                        "qubits_used": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
